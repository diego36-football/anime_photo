# OpenAI API 설정
OPENAI_API_KEY=your_openai_api_key_here

# YouTube API 설정
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성 필요
# client_secrets.json 파일을 config/ 디렉토리에 저장

# n8n 설정 (옵션)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Discord/Slack 알림 (옵션)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# 영상 생성 설정
VIDEO_DURATION=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# 업로드 설정
YOUTUBE_PRIVACY_STATUS=public  # public, private, unlisted
YOUTUBE_CATEGORY_ID=22  # People & Blogs
